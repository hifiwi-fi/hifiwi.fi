{
  "name": "hifiwi.fi",
  "description": "HifiWi.fi website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/hifiwi-fi/hifiwi.fi/issues"
  },
  "devDependencies": {
    "@domstack/static": "^11.0.3",
    "@voxpelli/tsconfig": "^16.2.1",
    "classnames": "^2.3.2",
    "fragtml": "^0.0.9",
    "jsonfeed-to-atom": "^1.2.4",
    "neostandard": "^0.13.0",
    "npm-run-all2": "^9.0.0",
    "p-map": "^7.0.2",
    "releasearoni": "^0.2.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "highlight.js": "^11.5.0",
    "mine.css": "^11.0.11",
    "xmlbuilder": "^15.1.1"
  },
  "homepage": "https://github.com/hifiwi-fi/hifiwi.fi",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/hifiwi-fi/hifiwi.fi.git"
  },
  "scripts": {
    "test": "run-s test:*",
    "test:lint": "eslint",
    "test:types": "tsc --noEmit",
    "test:build": "run-s build",
    "build": "npm run clean && run-p build:*",
    "build:domstack": "domstack",
    "watch": "npm run clean && run-p watch:*",
    "watch:domstack": "npm run build:domstack -- --watch --drafts",
    "generate-icon": "npx gravatar-favicons --config favicon-config.js",
    "clean": "rm -rf public && mkdir -p public",
    "start": "npm run watch",
    "release": "releasearoni --no-npm-check",
    "version": "releasearoni version",
    "new-blogpost": "node scripts/create-blogpost.js --title",
    "publish-draft": "node scripts/publish-draft.js"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  }
}
